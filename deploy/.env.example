# Copy to /opt/wechat-publisher/secrets/publisher.env; chmod 600.
PUBLISHER_ORIGIN=https://publish.hardway.top
PUBLISHER_DATA_DIR=/app/data
COOKIE_SECURE=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Personal Android App auto-login. Use a high-entropy value generated with the APK; do not commit the real value.
PUBLISHER_ANDROID_TOKEN=
PUBLISHER_ANDROID_USER=admin
# Web sessions and upload tokens are random, stored as SHA256 hashes in SQLite.
# No SESSION_SECRET / DATA_ENCRYPTION_KEY is required in this implementation.
